ui = true

listener "tcp" {
  address     = "0.0.0.0:{{ vault_port }}"
  tls_disable = 1
}

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "vault-node-1"
}

api_addr     = "http://0.0.0.0:{{ vault_port }}"
cluster_addr = "http://0.0.0.0:8201"

# Log to stdout (captured by Docker → journald via systemd service)
# No log_file directive: avoids host path permission issues with Docker UID 100
log_level = "info"
