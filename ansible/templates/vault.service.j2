[Unit]
Description=HashiCorp Vault (Docker)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f vault
ExecStart=/usr/bin/docker run \
  --name vault \
  --rm \
  --cap-add=IPC_LOCK \
  -p 127.0.0.1:{{ vault_port }}:{{ vault_port }} \
  -p 127.0.0.1:8201:8201 \
  -v {{ vault_config_dir }}/vault.hcl:/vault/config/vault.hcl:ro \
  -v {{ vault_data_dir }}:/vault/data \
  -e VAULT_LOG_LEVEL=info \
  hashicorp/vault:latest \
  vault server -config=/vault/config/vault.hcl
ExecStop=/usr/bin/docker stop vault
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault

[Install]
WantedBy=multi-user.target
